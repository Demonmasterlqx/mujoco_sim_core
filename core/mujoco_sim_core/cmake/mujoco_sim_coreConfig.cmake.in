@PACKAGE_INIT@

get_filename_component(_mujoco_sim_core_prefix
  "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

include(CMakeFindDependencyMacro)
find_dependency(mujoco_sim_protocol)

if(@MUJOCO_SIM_USE_BUNDLED_MUJOCO@ AND NOT TARGET mujoco_vendor)
  add_library(mujoco_vendor SHARED IMPORTED)
  set_target_properties(mujoco_vendor PROPERTIES
    IMPORTED_LOCATION "${_mujoco_sim_core_prefix}/@CMAKE_INSTALL_LIBDIR@/libmujoco.so.3.10.0"
    INTERFACE_INCLUDE_DIRECTORIES "${_mujoco_sim_core_prefix}/@CMAKE_INSTALL_INCLUDEDIR@"
  )
endif()
if(@MUJOCO_SIM_USE_BUNDLED_MUJOCO@ AND NOT TARGET mujoco::mujoco)
  add_library(mujoco::mujoco ALIAS mujoco_vendor)
elseif(NOT @MUJOCO_SIM_USE_BUNDLED_MUJOCO@)
  find_dependency(mujoco CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_sim_coreTargets.cmake")
check_required_components(mujoco_sim_core)

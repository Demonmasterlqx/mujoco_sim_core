set(stage_prefix "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_install")
set(consumer_build "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_build")
file(REMOVE_RECURSE "${stage_prefix}" "${consumer_build}")

execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
          --prefix "${stage_prefix}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "failed to stage mujoco_sim_hardware_interface")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@"
          -S "@CMAKE_CURRENT_SOURCE_DIR@/test/package_consumer"
          -B "${consumer_build}"
          "-DCMAKE_PREFIX_PATH=${stage_prefix};$ENV{CMAKE_PREFIX_PATH}"
          "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@"
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "failed to configure mujoco_sim_hardware_interface consumer")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${consumer_build}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "failed to build mujoco_sim_hardware_interface consumer")
endif()

execute_process(
  COMMAND "${consumer_build}/package_consumer"
  RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
  message(FATAL_ERROR "mujoco_sim_hardware_interface consumer returned ${run_result}")
endif()

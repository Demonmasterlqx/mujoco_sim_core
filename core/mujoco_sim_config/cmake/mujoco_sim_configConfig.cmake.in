@PACKAGE_INIT@

set(_mujoco_sim_config_package_prefix "${PACKAGE_PREFIX_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(CLI11 CONFIG)
find_dependency(Python3 COMPONENTS Interpreter)
find_dependency(yaml-cpp CONFIG)

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_sim_configTargets.cmake")

set(MUJOCO_SIM_CONFIG_GENERATOR
  "${_mujoco_sim_config_package_prefix}/@CMAKE_INSTALL_DATADIR@/mujoco_sim_config/generator/mujoco_sim_config_generator.py"
)
set(MUJOCO_SIM_CONFIG_TEMPLATE_DIR
  "${_mujoco_sim_config_package_prefix}/@CMAKE_INSTALL_DATADIR@/mujoco_sim_config/generator/templates"
)
file(GLOB MUJOCO_SIM_CONFIG_GENERATOR_DEPENDENCIES
  "${_mujoco_sim_config_package_prefix}/@CMAKE_INSTALL_DATADIR@/mujoco_sim_config/generator/mujoco_sim_config_codegen/*.py"
)
include("${CMAKE_CURRENT_LIST_DIR}/mujoco_sim_generate_config.cmake")

check_required_components(mujoco_sim_config)

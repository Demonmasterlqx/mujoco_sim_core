set(deployment_dir "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_stage")
set(stage_dir "${deployment_dir}/mujoco_sim_server")
set(build_dir "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_build")

file(REMOVE_RECURSE "${deployment_dir}" "${build_dir}")

execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
          --prefix "${stage_dir}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "Failed to install mujoco_sim_server test package")
endif()

get_filename_component(
  core_prefix "@mujoco_sim_core_DIR@/../../.." ABSOLUTE
)
file(GLOB mujoco_runtime "${core_prefix}/@CMAKE_INSTALL_LIBDIR@/libmujoco.so*")
if(NOT mujoco_runtime)
  message(FATAL_ERROR "Failed to locate the installed MuJoCo runtime")
endif()
set(core_runtime_dir
  "${deployment_dir}/mujoco_sim_core/@CMAKE_INSTALL_LIBDIR@"
)
file(MAKE_DIRECTORY "${core_runtime_dir}")
file(COPY ${mujoco_runtime} DESTINATION "${core_runtime_dir}")

execute_process(
  COMMAND "@CMAKE_COMMAND@"
          -S "@CMAKE_CURRENT_SOURCE_DIR@/test/package_consumer"
          -B "${build_dir}"
          "-Dmujoco_sim_server_DIR=${stage_dir}/@CMAKE_INSTALL_LIBDIR@/cmake/mujoco_sim_server"
          "-Dmujoco_sim_config_DIR=@mujoco_sim_config_DIR@"
          "-DCLI11_DIR=@CLI11_DIR@"
          "-DeCAL_DIR=@eCAL_DIR@"
          "-Dglfw3_DIR=@glfw3_DIR@"
          "-Dmujoco_sim_core_DIR=@mujoco_sim_core_DIR@"
          "-Dmujoco_sim_protocol_DIR=@mujoco_sim_protocol_DIR@"
          "-Dyaml-cpp_DIR=@yaml-cpp_DIR@"
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "Failed to configure mujoco_sim_server package consumer")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${build_dir}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "Failed to build mujoco_sim_server package consumer")
endif()

execute_process(
  COMMAND "${build_dir}/package_consumer@CMAKE_EXECUTABLE_SUFFIX@"
  RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
  message(FATAL_ERROR "Failed to run mujoco_sim_server package consumer")
endif()

execute_process(
  COMMAND "${stage_dir}/@CMAKE_INSTALL_BINDIR@/mujoco-sim-server@CMAKE_EXECUTABLE_SUFFIX@"
          --help
  RESULT_VARIABLE server_run_result
  OUTPUT_VARIABLE server_help
  ERROR_VARIABLE server_error
)
if(NOT server_run_result EQUAL 0 OR
   NOT server_help MATCHES "--headless")
  message(FATAL_ERROR
    "Failed to run installed mujoco-sim-server: ${server_error}"
  )
endif()

set(status_executable
  "${stage_dir}/@CMAKE_INSTALL_BINDIR@/mujoco-sim-status@CMAKE_EXECUTABLE_SUFFIX@"
)
execute_process(
  COMMAND "${status_executable}" --help
  RESULT_VARIABLE status_run_result
  OUTPUT_VARIABLE status_help
  ERROR_VARIABLE status_error
)
if(NOT status_run_result EQUAL 0 OR NOT status_help MATCHES "--watch")
  message(FATAL_ERROR
    "Failed to run installed mujoco-sim-status: ${status_error}"
  )
endif()

find_program(READELF_EXECUTABLE readelf REQUIRED)
execute_process(
  COMMAND "${READELF_EXECUTABLE}" -d "${status_executable}"
  RESULT_VARIABLE readelf_result
  OUTPUT_VARIABLE status_dynamic_section
  ERROR_VARIABLE readelf_error
)
if(NOT readelf_result EQUAL 0)
  message(FATAL_ERROR "Failed to inspect mujoco-sim-status: ${readelf_error}")
endif()
if(status_dynamic_section MATCHES
   "libmujoco[.]so|libmujoco_sim_core[.]so|libmujoco_sim_server|libglfw|libpng|libGL|libOpenGL|libEGL|libGLES|libX11|libxcb|libwayland")
  message(FATAL_ERROR
    "mujoco-sim-status has an unexpected heavy dependency:\n${status_dynamic_section}"
  )
endif()

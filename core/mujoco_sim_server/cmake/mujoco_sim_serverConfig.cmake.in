@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(eCAL)
find_dependency(mujoco_sim_config)
find_dependency(mujoco_sim_core)
find_dependency(mujoco_sim_protocol)
if(@MUJOCO_SIM_BUILD_GUI@)
  find_dependency(glfw3 CONFIG)
  find_dependency(PNG)
endif()
if(@MUJOCO_SIM_BUILD_SENSOR_STREAMS@)
  find_dependency(mujoco_sim_sensor)
endif()
find_dependency(spdlog CONFIG)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_sim_serverTargets.cmake")
check_required_components(mujoco_sim_server)

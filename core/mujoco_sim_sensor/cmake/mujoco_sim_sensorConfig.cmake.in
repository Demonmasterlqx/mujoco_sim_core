@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(mujoco_sim_core CONFIG)
find_dependency(mujoco_sim_protocol CONFIG)
find_dependency(PkgConfig)
pkg_check_modules(EGL REQUIRED IMPORTED_TARGET egl)
pkg_check_modules(OSMesa REQUIRED IMPORTED_TARGET osmesa)

include("${CMAKE_CURRENT_LIST_DIR}/mujoco_sim_sensorTargets.cmake")
check_required_components(mujoco_sim_sensor)

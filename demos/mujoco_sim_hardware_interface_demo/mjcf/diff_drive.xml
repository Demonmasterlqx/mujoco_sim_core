<mujoco model="mujoco_sim_hardware_interface_diff_drive">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.03" armature="0.005"/>
    <geom friction="1.2 0.01 0.001" density="600" rgba="0.25 0.45 0.75 1"/>
  </default>

  <worldbody>
    <geom name="floor" type="plane" size="8 8 0.1" rgba="0.8 0.8 0.8 1"/>
    <body name="base_link" pos="0 0 0.23">
      <freejoint name="base_free_joint"/>
      <geom name="chassis" type="box" size="0.25 0.18 0.07" mass="4"/>
      <site name="imu_site" pos="0 0 0.06" size="0.01" rgba="1 0 0 1"/>

      <body name="left_wheel" pos="0 0.23 -0.10">
        <joint name="left_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="left_wheel_geom" type="cylinder" size="0.10 0.035"
              euler="1.57079632679 0 0" mass="0.6" rgba="0.1 0.1 0.1 1"/>
      </body>
      <body name="right_wheel" pos="0 -0.23 -0.10">
        <joint name="right_wheel_joint" type="hinge" axis="0 1 0"/>
        <geom name="right_wheel_geom" type="cylinder" size="0.10 0.035"
              euler="1.57079632679 0 0" mass="0.6" rgba="0.1 0.1 0.1 1"/>
      </body>
      <geom name="front_caster" type="sphere" pos="0.20 0 -0.16" size="0.035"
            mass="0.05" rgba="0.15 0.15 0.15 1"/>
      <geom name="rear_caster" type="sphere" pos="-0.20 0 -0.16" size="0.035"
            mass="0.05" rgba="0.15 0.15 0.15 1"/>
    </body>
  </worldbody>

  <actuator>
    <velocity name="left_wheel_actuator" joint="left_wheel_joint" kv="1"
              ctrllimited="true" ctrlrange="-12 12"
              forcelimited="true" forcerange="-3 3"/>
    <velocity name="right_wheel_actuator" joint="right_wheel_joint" kv="1"
              ctrllimited="true" ctrlrange="-12 12"
              forcelimited="true" forcerange="-3 3"/>
  </actuator>

  <sensor>
    <jointpos name="left_wheel_position" joint="left_wheel_joint"/>
    <jointvel name="left_wheel_velocity" joint="left_wheel_joint"/>
    <jointpos name="right_wheel_position" joint="right_wheel_joint"/>
    <jointvel name="right_wheel_velocity" joint="right_wheel_joint"/>
    <accelerometer name="imu_acceleration" site="imu_site"/>
    <gyro name="imu_angular_velocity" site="imu_site"/>
    <framequat name="imu_orientation" objtype="site" objname="imu_site"/>
    <framepos name="imu_position" objtype="site" objname="imu_site"/>
    <framepos name="base_position_debug" objtype="body" objname="base_link"/>
  </sensor>
</mujoco>

  <version>0.1.0</version>
  <description>Four-process MuJoCo sensor, control, and PCL mapping demo.</description>
  <maintainer email="pnx@example.com">pnx</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>cmake</buildtool_depend>
  <depend>pkg-config</depend>
  <depend>libeigen3-dev</depend>
  <depend>libpcl-dev</depend>
  <depend>libpng-dev</depend>

set(stage_dir "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_stage")
set(build_dir "@CMAKE_CURRENT_BINARY_DIR@/package_consumer_build")
file(REMOVE_RECURSE "${stage_dir}" "${build_dir}")

execute_process(
  COMMAND "@CMAKE_COMMAND@" --install "@CMAKE_CURRENT_BINARY_DIR@"
          --prefix "${stage_dir}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "failed to stage mujoco_sim_sensor_demo")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@"
          -S "@CMAKE_CURRENT_SOURCE_DIR@/test/package_consumer"
          -B "${build_dir}"
          "-DCMAKE_PREFIX_PATH=${stage_dir};$ENV{CMAKE_PREFIX_PATH}"
          "-Dmujoco_sim_adapter_sdk_DIR=@mujoco_sim_adapter_sdk_DIR@"
          "-Dmujoco_sim_protocol_DIR=@mujoco_sim_protocol_DIR@"
          "-DeCAL_DIR=@eCAL_DIR@"
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "failed to configure sensor Demo package consumer")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${build_dir}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "failed to build sensor Demo package consumer")
endif()

execute_process(
  COMMAND "${build_dir}/package_consumer@CMAKE_EXECUTABLE_SUFFIX@"
  RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
  message(FATAL_ERROR "sensor Demo package consumer returned ${run_result}")
endif()

set(bin_dir "${stage_dir}/@CMAKE_INSTALL_BINDIR@")
foreach(executable IN ITEMS
    mujoco-sim-sensor-demo-controller
    mujoco-sim-sensor-demo-state-observer
    mujoco-sim-sensor-demo-camera-consumer
    mujoco-sim-sensor-demo-mapper)
  execute_process(
    COMMAND "${bin_dir}/${executable}@CMAKE_EXECUTABLE_SUFFIX@" --help
    RESULT_VARIABLE help_result
    OUTPUT_VARIABLE help_output
    ERROR_VARIABLE help_error
  )
  if(NOT help_result EQUAL 0 OR NOT help_output MATCHES "--config")
    message(FATAL_ERROR
      "installed ${executable} help failed: ${help_error}"
    )
  endif()
endforeach()

set(share_dir "${stage_dir}/@CMAKE_INSTALL_DATADIR@/mujoco_sim_sensor_demo")
foreach(relative_path IN ITEMS
    README.md
    config/sensor_demo.schema.yaml
    config/sensor_demo.yaml
    config/sensor_demo_server.yaml
    mjcf/scene.xml)
  if(NOT EXISTS "${share_dir}/${relative_path}")
    message(FATAL_ERROR "installed Demo asset is missing: ${relative_path}")
  endif()
endforeach()
if(NOT EXISTS "${bin_dir}/mujoco-sim-sensor-demo-launch")
  message(FATAL_ERROR "installed sensor Demo launcher is missing")
endif()
